    "sec_base_avg = ext_df[\"sec_base_mrr\"].mean()\n",
    "sec_dyn_avg = ext_df[\"sec_dyn_mrr\"].mean()\n",
    "uns_base_avg = ext_df[\"uns_base_mrr\"].mean()\n",
    "uns_dyn_avg = ext_df[\"uns_dyn_mrr\"].mean()\n",
    "\n",
    "# Improvement counts\n",
    "sec_imp = (ext_df[\"sec_delta_mrr\"] > 0).sum()\n",
    "sec_reg = (ext_df[\"sec_delta_mrr\"] < 0).sum()\n",
    "uns_imp = (ext_df[\"uns_delta_mrr\"] > 0).sum()\n",
    "uns_reg = (ext_df[\"uns_delta_mrr\"] < 0).sum()\n",
    "\n",
    "print(f\"\\n  ┌─────────────────────┬──────────────┬──────────────┬──────────────┐\")\n",
    "print(f\"  │  Pipeline           │  Baseline    │  Dynamic     │  Δ (router)  │\")\n",
    "print(f\"  ├─────────────────────┼──────────────┼──────────────┼──────────────┤\")\n",
    "print(f\"  │  Secure (RBAC on)   │  MRR={sec_base_avg:.4f}  │  MRR={sec_dyn_avg:.4f}  │  {sec_dyn_avg - sec_base_avg:+.4f}      │\")\n",
    "print(f\"  │  Unsecured (RBAC off)│  MRR={uns_base_avg:.4f}  │  MRR={uns_dyn_avg:.4f}  │  {uns_dyn_avg - uns_base_avg:+.4f}      │\")\n",
    "print(f\"  └─────────────────────┴──────────────┴──────────────┴──────────────┘\")\n",
    "\n",
    "print(f\"\\n  Router improvements:\")\n",
    "print(f\"    Secure pipeline:    {sec_imp} improved / {sec_reg} regressed / {len(ext_df) - sec_imp - sec_reg} unchanged\")\n",
    "print(f\"    Unsecured pipeline: {uns_imp} improved / {uns_reg} regressed / {len(ext_df) - uns_imp - uns_reg} unchanged\")\n",
    "\n",
    "# By category — where does the router add most value?\n",
    "print(f\"\\n  Router delta by query category:\")\n",
    "for cat in [\"exact\", \"conceptual\", \"mixed\"]:\n",
    "    sub = ext_df[ext_df[\"category\"] == cat]\n",
    "    if len(sub) == 0: continue\n",
    "    sd = sub[\"sec_delta_mrr\"].mean()\n",
    "    ud = sub[\"uns_delta_mrr\"].mean()\n",
