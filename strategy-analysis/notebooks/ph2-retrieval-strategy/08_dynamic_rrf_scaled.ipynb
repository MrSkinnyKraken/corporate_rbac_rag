    "# Cell 9 — Run the 4-way comparison: {secure, unsec} x {baseline, dynamic}\n",
    "\n",
    "ext_results = []\n",
    "\n",
    "for tq in QUERIES:\n",
    "    ic = classify(tq.query)\n",
    "\n",
    "    # Secure\n",
    "    res_sec_base = secure_rrf(tq.query, tq.user_cl, tq.user_dept, K, alpha=0.5)\n",
    "    res_sec_dyn = secure_rrf(tq.query, tq.user_cl, tq.user_dept, K, alpha=ic.alpha)\n",
    "    m_sec_base = compute_metrics(res_sec_base, tq)\n",
    "    m_sec_dyn = compute_metrics(res_sec_dyn, tq)\n",
    "\n",
    "    # Unsecured\n",
    "    res_uns_base = unsec_rrf(tq.query, K, alpha=0.5)\n",
    "    res_uns_dyn = unsec_rrf(tq.query, K, alpha=ic.alpha)\n",
    "    m_uns_base = compute_metrics(res_uns_base, tq)\n",
    "    m_uns_dyn = compute_metrics(res_uns_dyn, tq)\n",
    "\n",
    "    ext_results.append({\n",
    "        \"qid\": tq.qid, \"category\": tq.category, \"intent\": ic.intent, \"alpha_dyn\": ic.alpha,\n",
    "        # Secure pipeline\n",
    "        \"sec_base_mrr\": m_sec_base[\"mrr\"], \"sec_dyn_mrr\": m_sec_dyn[\"mrr\"],\n",
    "        \"sec_base_rank\": m_sec_base[\"first_rank\"], \"sec_dyn_rank\": m_sec_dyn[\"first_rank\"],\n",
    "        \"sec_delta_mrr\": round(m_sec_dyn[\"mrr\"] - m_sec_base[\"mrr\"], 4),\n",
    "        # Unsecured pipeline\n",
    "        \"uns_base_mrr\": m_uns_base[\"mrr\"], \"uns_dyn_mrr\": m_uns_dyn[\"mrr\"],\n",
    "        \"uns_base_rank\": m_uns_base[\"first_rank\"], \"uns_dyn_rank\": m_uns_dyn[\"first_rank\"],\n",
    "        \"uns_delta_mrr\": round(m_uns_dyn[\"mrr\"] - m_uns_base[\"mrr\"], 4),\n",
    "        # Router value at secure/unsecured\n",
    "    })\n",
    "\n",
    "ext_df = pd.DataFrame(ext_results)\n",
    "\n",
    "print(\"=\" * 115)\n",
    "print(\"  4-WAY COMPARISON: DYNAMIC ROUTER IMPACT WITH vs WITHOUT SECURITY FILTERING\")\n",
