    "# Aggregates\n",
    "avg_base = df[\"base_mrr\"].mean()\n",
    "avg_dyn = df[\"dyn_mrr\"].mean()\n",
    "improved = (df[\"delta_mrr\"] > 0).sum()\n",
    "regressed = (df[\"delta_mrr\"] < 0).sum()\n",
    "unchanged = (df[\"delta_mrr\"] == 0).sum()\n",
    "\n",
    "print(f\"\\n{'─'*60}\")\n",
    "print(f\"  AGGREGATE METRICS\")\n",
    "print(f\"{'─'*60}\")\n",
