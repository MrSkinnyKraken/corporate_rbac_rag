    "# Identify queries where the router made a concrete difference in the unsecured pipeline\n",
    "print(f\"\\n  Queries where the router rescued the unsecured pipeline (UNS ΔMRR > 0):\")\n",
    "wins = ext_df[ext_df[\"uns_delta_mrr\"] > 0]\n",
