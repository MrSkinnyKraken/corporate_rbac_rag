   "source": [
    "# Cell 5 — Execute: Baseline (α=0.5) vs Dynamic (α from router)\n",
    "\n",
    "def is_relevant(doc: Document, relevant_files: list[str], relevant_kw: list[str]) -> bool:\n",
    "    src = doc.metadata.get(\"source_file\", \"\")\n",
    "    text = doc.page_content.lower()\n",
    "    file_match = any(f.lower() in src.lower() for f in relevant_files)\n",
    "    kw_match = any(kw.lower() in text for kw in relevant_kw) if relevant_kw else True\n",
    "    return file_match and kw_match\n",
    "\n",
    "def compute_metrics(results: list[RR], tq: TQ) -> dict:\n",
    "    mrr = 0.0\n",
    "    rel3 = 0\n",
    "    rel5 = 0\n",
    "    first_rank = None\n",
    "    for r in results:\n",
    "        hit = is_relevant(r.document, tq.relevant_files, tq.relevant_kw)\n",
    "        if hit:\n",
    "            if first_rank is None:\n",
    "                first_rank = r.rank\n",
    "                mrr = 1.0 / r.rank\n",
    "            if r.rank <= 3:\n",
    "                rel3 += 1\n",
    "            if r.rank <= 5:\n",
    "                rel5 += 1\n",
    "    return {\"mrr\": mrr, \"rel3\": rel3, \"rel5\": rel5, \"first_rank\": first_rank or 0}\n",
    "\n",
    "all_results = []\n",
    "\n",
    "for tq in QUERIES:\n",
    "    ic = classify(tq.query)\n",
    "\n",
    "    # Baseline: static α=0.5\n",
    "    res_base = secure_rrf(tq.query, tq.user_cl, tq.user_dept, K, alpha=0.5)\n",
    "    m_base = compute_metrics(res_base, tq)\n",
    "\n",
    "    # Dynamic: α from intent router\n",
    "    res_dyn = secure_rrf(tq.query, tq.user_cl, tq.user_dept, K, alpha=ic.alpha)\n",
    "    m_dyn = compute_metrics(res_dyn, tq)\n",
    "\n",
    "    delta_mrr = m_dyn[\"mrr\"] - m_base[\"mrr\"]\n",
    "    delta_rank = m_base[\"first_rank\"] - m_dyn[\"first_rank\"]  # positive = dynamic is better\n",
    "\n",
    "    print(f\"{tq.qid} [{tq.category:10s}] α_dyn={ic.alpha}  intent={ic.intent}\")\n",
    "    print(f\"  Baseline(α=0.5): MRR={m_base['mrr']:.3f}  R@3={m_base['rel3']}  R@5={m_base['rel5']}  1st@{m_base['first_rank']}\")\n",
    "    print(f\"  Dynamic(α={ic.alpha}):  MRR={m_dyn['mrr']:.3f}  R@3={m_dyn['rel3']}  R@5={m_dyn['rel5']}  1st@{m_dyn['first_rank']}\")\n",
    "    print(f\"  ΔMRR={delta_mrr:+.3f}  Δrank={delta_rank:+d}  {'✓ BETTER' if delta_mrr > 0 else ('= EQUAL' if delta_mrr == 0 else '✗ WORSE')}\")\n",
    "    print()\n",
    "\n",
    "    all_results.append({\n",
    "        \"qid\": tq.qid, \"query\": tq.query, \"category\": tq.category,\n",
    "        \"user_cl\": tq.user_cl, \"user_dept\": tq.user_dept,\n",
    "        \"description\": tq.description,\n",
    "        \"intent\": ic.intent, \"alpha_dyn\": ic.alpha,\n",
    "        \"base_mrr\": m_base[\"mrr\"], \"dyn_mrr\": m_dyn[\"mrr\"],\n",
    "        \"base_rel3\": m_base[\"rel3\"], \"dyn_rel3\": m_dyn[\"rel3\"],\n",
    "        \"base_rel5\": m_base[\"rel5\"], \"dyn_rel5\": m_dyn[\"rel5\"],\n",
    "        \"base_first_rank\": m_base[\"first_rank\"], \"dyn_first_rank\": m_dyn[\"first_rank\"],\n",
    "        \"delta_mrr\": round(delta_mrr, 4),\n",
    "        \"delta_rank\": delta_rank,\n",
    "    })"
   ]
  },
