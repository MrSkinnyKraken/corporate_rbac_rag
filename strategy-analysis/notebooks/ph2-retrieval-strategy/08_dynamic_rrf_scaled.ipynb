    "# Cell 10 — Aggregate analysis + export\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"  AGGREGATE: ROUTER VALUE IN SECURE vs UNSECURED ENVIRONMENTS\")\n",
