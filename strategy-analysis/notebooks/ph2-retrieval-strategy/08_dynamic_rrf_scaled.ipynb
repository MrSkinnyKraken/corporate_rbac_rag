    "print(f\"  Mean MRR dynamic:  {avg_dyn:.4f}\")\n",
    "print(f\"  ΔMRR:              {avg_dyn - avg_base:+.4f} ({(avg_dyn - avg_base)/max(avg_base,0.001)*100:+.1f}%)\")\n",
    "print(f\"  Queries improved:  {improved}/{len(df)}\")\n",
    "print(f\"  Queries regressed: {regressed}/{len(df)}\")\n",
    "print(f\"  Queries unchanged: {unchanged}/{len(df)}\")\n",
