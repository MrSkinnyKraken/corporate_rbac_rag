# =============================================================================
# .env.example — configuration template for the Zero-Trust RAG system.
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your local environment.
# Never commit `.env` to version control (it must be listed in .gitignore).
#
# Variables are loaded by `core/config.py` via pydantic-settings. Unknown
# variables are silently ignored, so feel free to add private extras here.
# =============================================================================

# ─── ChromaDB (vector store, runs as an independent local service) ──────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# ─── Ollama (local LLM server) ──────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT_S=180
OLLAMA_NUM_CTX=8192

# ─── Embedding model (used to build ChromaDB vectors) ───────────────────────
# Production default is the multilingual MiniLM-L12 after Phase 3 Step 4 Q4
# finding: the English-only `all-MiniLM-L6-v2` failed to align English queries
# with Spanish-language contract clauses. Both models output 384 dims but the
# vector spaces are geometrically incompatible — changing this value INVALIDATES
# every existing ChromaDB collection. The retriever's runtime guard raises
# ConfigurationError on mismatch; re-ingest the corpus before resuming service.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# ─── Application paths (auto-created on first run if missing) ───────────────
RAW_DOCS_DIR=./data/raw_docs
BM25_INDEX_DIR=./data/bm25_indexes
ARTIFACTS_DIR=./data/artifacts

# ─── Demo user fixture (no OAuth yet — see project memory) ──────────────────
# JSON file mapping user_id -> {username, clearance_level, department, email}.
# The Streamlit frontend reads this to populate the user-picker dropdown.
USERS_FIXTURE_PATH=./data/demo_users.json

# ─── FastAPI backend ────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info

# ─── Streamlit frontend ─────────────────────────────────────────────────────
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501

# ─── Application-wide log level ─────────────────────────────────────────────
APP_LOG_LEVEL=INFO
